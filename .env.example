# ─────────────────────────────────────────────────────────
# Live Quran Teaching — environment configuration template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────

# Port the server listens on locally (hosting providers override this automatically)
PORT=3000

# Teacher login password — replace with a strong, unique password before going live
TEACHER_PASSWORD=replace_with_your_own_password

# Secret used to sign the session cookie — use a long random string in production
SESSION_SECRET=replace_with_a_long_random_secret_string

# Set to "production" on live servers
NODE_ENV=development